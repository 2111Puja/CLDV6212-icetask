# Copy to .env for local Docker use. NEVER commit the real .env file.
ASPNETCORE_ENVIRONMENT=Development
PORT=8080

# Supabase -> Project Settings -> Database -> Connection string -> "Session pooler"
# (Render cannot use the direct db.<ref>.supabase.co host: it is IPv6-only.)
ConnectionStrings__DefaultConnection=Host=aws-0-<region>.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.<project-ref>;Password=<your-database-password>;SSL Mode=Require;Trust Server Certificate=true

# Municipality staff login (change these on Render)
Staff__Username=staff@municipality.gov.za
Staff__Password=Municipal@2026
Staff__DisplayName=Municipal Staff
