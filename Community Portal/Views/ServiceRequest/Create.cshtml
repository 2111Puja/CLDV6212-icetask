@{
    ViewData["Title"] = "Report a Problem";
}

@* Styles for the photo preview and the confetti canvas. Kept in this view so no other file has to change. *@
<style>
    .photo-preview {
        border: 1px solid #cfe3f7;
        background: #f3f9ff;
        border-radius: 10px;
        padding: 0.75rem;
    }

        .photo-preview img {
            display: block;
            max-width: 100%;
            max-height: 260px;
            margin: 0 auto;
            border-radius: 8px;
            box-shadow: 0 2px 8px rgba(0, 42, 92, 0.18);
            object-fit: contain;
            background: #ffffff;
        }

    .photo-success {
        color: #107c41;
        font-weight: 600;
    }

    /* The card header uses bg-navy, which site.css does not define, so define it here */
    .bg-navy { background-color: var(--primary-navy, #002a5c) !important; }

    /* Keep the Submit button blue (not washed out) while it is disabled during the confetti */
    #submitReport:disabled {
        background-color: var(--azure-blue, #0078d4);
        border-color: var(--azure-blue, #0078d4);
        color: #ffffff;
        opacity: 0.85;
    }

    #confettiCanvas {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        pointer-events: none;
        z-index: 2000;
    }
</style>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card card-custom shadow-sm border-0">
            <div class="card-header bg-navy text-white p-3">
                <h4 class="mb-0">Report a Community Problem</h4>
            </div>
            <div class="card-body p-4">
                <form id="reportForm" asp-controller="ServiceRequest" asp-action="Create" method="post" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label class="form-label fw-bold">Issue Type</label>
                        <select name="issueType" class="form-select" required>
                            <option value="">-- Select Issue Type --</option>
                            <option value="Water Leak">Water Leak / Pipe Burst</option>
                            <option value="Pothole">Pothole / Road Repair</option>
                            <option value="Streetlight">Broken Streetlight</option>
                            <option value="Waste">Uncollected Refuse / Illegal Dumping</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Description</label>
                        <textarea name="description" class="form-control" rows="4" placeholder="Provide details about the issue..." required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Location Address</label>
                        <input type="text" name="location" class="form-control" placeholder="Enter street address or landmark" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold" for="photoInput">Upload Photo (Optional)</label>
                        <input type="file" id="photoInput" name="photo" class="form-control" accept="image/*" />

                        <!-- Shown as soon as a photo is chosen: confirmation message + a preview of the image -->
                        <div id="photoFeedback" class="mt-2" role="status" aria-live="polite" hidden>
                            <div id="photoSuccess" class="photo-success mb-2" hidden>
                                <i class="bi bi-check-circle-fill me-1"></i>Image uploaded successfully
                            </div>
                            <div id="photoError" class="text-danger small mb-2" hidden></div>

                            <div id="photoPreview" class="photo-preview" hidden>
                                <img id="photoPreviewImg" src="" alt="Preview of the selected photo" />
                                <div class="d-flex justify-content-between align-items-center mt-2 small text-muted">
                                    <span id="photoName" class="text-truncate me-2"></span>
                                    <button type="button" id="photoRemove" class="btn btn-sm btn-outline-secondary">Remove</button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" id="submitReport" class="btn btn-azure btn-lg">Submit Report</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

<canvas id="confettiCanvas" aria-hidden="true" hidden></canvas>

@section Scripts {
    <script>
        (function () {
            // ---------------------------------------------------------------
            // 1. Photo preview + "Image uploaded successfully" message
            // ---------------------------------------------------------------
            var MAX_PHOTO_BYTES = 5 * 1024 * 1024; // 5 MB

            var input = document.getElementById('photoInput');
            var feedback = document.getElementById('photoFeedback');
            var success = document.getElementById('photoSuccess');
            var errorBox = document.getElementById('photoError');
            var preview = document.getElementById('photoPreview');
            var previewImg = document.getElementById('photoPreviewImg');
            var nameLabel = document.getElementById('photoName');
            var removeBtn = document.getElementById('photoRemove');
            var currentUrl = null;

            function clearPhoto() {
                if (currentUrl) { URL.revokeObjectURL(currentUrl); currentUrl = null; }
                input.value = '';
                previewImg.removeAttribute('src');
                feedback.hidden = true;
                success.hidden = true;
                errorBox.hidden = true;
                preview.hidden = true;
            }

            function showError(message) {
                clearPhoto();
                errorBox.textContent = message;
                errorBox.hidden = false;
                feedback.hidden = false;
            }

            input.addEventListener('change', function () {
                var file = input.files && input.files[0];
                if (!file) { clearPhoto(); return; }

                if (!file.type || file.type.indexOf('image/') !== 0) {
                    showError('Please choose an image file (JPEG, PNG, GIF or WebP).');
                    return;
                }
                if (file.size > MAX_PHOTO_BYTES) {
                    showError('That photo is too large. Please choose an image under 5 MB.');
                    return;
                }

                if (currentUrl) { URL.revokeObjectURL(currentUrl); }
                currentUrl = URL.createObjectURL(file);

                previewImg.src = currentUrl;
                nameLabel.textContent = file.name + ' (' + (file.size / 1024 < 1024
                    ? Math.max(1, Math.round(file.size / 1024)) + ' KB'
                    : (file.size / 1048576).toFixed(1) + ' MB') + ')';

                errorBox.hidden = true;
                success.hidden = false;
                preview.hidden = false;
                feedback.hidden = false;
            });

            removeBtn.addEventListener('click', clearPhoto);

            // ---------------------------------------------------------------
            // 2. Confetti when Submit Report is clicked
            // ---------------------------------------------------------------
            var form = document.getElementById('reportForm');
            var submitBtn = document.getElementById('submitReport');
            var canvas = document.getElementById('confettiCanvas');
            var confettiDone = false;
            var CONFETTI_MS = 1600;
            var COLORS = ['#0078d4', '#002a5c', '#107c41', '#f0ad4e', '#d9534f', '#5cb6ff', '#ffffff'];

            function launchConfetti(originX, originY) {
                var ctx = canvas.getContext('2d');
                var dpr = window.devicePixelRatio || 1;
                canvas.hidden = false;
                canvas.width = window.innerWidth * dpr;
                canvas.height = window.innerHeight * dpr;
                ctx.scale(dpr, dpr);

                var pieces = [];
                for (var i = 0; i < 170; i++) {
                    var angle = (-Math.PI / 2) + (Math.random() - 0.5) * Math.PI * 0.95; // fan upwards
                    var speed = 9 + Math.random() * 11;
                    pieces.push({
                        x: originX, y: originY,
                        vx: Math.cos(angle) * speed,
                        vy: Math.sin(angle) * speed,
                        size: 6 + Math.random() * 6,
                        color: COLORS[Math.floor(Math.random() * COLORS.length)],
                        rot: Math.random() * Math.PI * 2,
                        vr: (Math.random() - 0.5) * 0.35,
                        round: Math.random() < 0.3
                    });
                }

                var start = null;
                function frame(ts) {
                    if (start === null) { start = ts; }
                    var elapsed = ts - start;
                    ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
                    var fade = elapsed > CONFETTI_MS - 450 ? Math.max(0, (CONFETTI_MS - elapsed) / 450) : 1;

                    for (var i = 0; i < pieces.length; i++) {
                        var p = pieces[i];
                        p.vy += 0.38;      // gravity
                        p.vx *= 0.992;     // air drag
                        p.x += p.vx;
                        p.y += p.vy;
                        p.rot += p.vr;

                        ctx.save();
                        ctx.globalAlpha = fade;
                        ctx.translate(p.x, p.y);
                        ctx.rotate(p.rot);
                        ctx.fillStyle = p.color;
                        if (p.round) {
                            ctx.beginPath();
                            ctx.arc(0, 0, p.size / 2, 0, Math.PI * 2);
                            ctx.fill();
                        } else {
                            ctx.fillRect(-p.size / 2, -p.size / 4, p.size, p.size / 2);
                        }
                        ctx.restore();
                    }

                    if (elapsed < CONFETTI_MS) {
                        requestAnimationFrame(frame);
                    } else {
                        ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
                        canvas.hidden = true;
                    }
                }
                requestAnimationFrame(frame);
            }

            // The browser only fires "submit" once the required fields are valid. We pause the post for a moment so the
            // confetti can play (otherwise the page would change instantly), then submit the form normally.
            form.addEventListener('submit', function (event) {
                if (confettiDone) { return; } // second pass: let the real submit go through
                event.preventDefault();

                var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Submitting...';

                if (reduceMotion) {
                    confettiDone = true;
                    form.submit();
                    return;
                }

                var rect = submitBtn.getBoundingClientRect();
                launchConfetti(rect.left + rect.width / 2, rect.top + rect.height / 2);

                setTimeout(function () {
                    confettiDone = true;
                    form.submit();
                }, CONFETTI_MS - 300);
            });

            // If the user comes back with the browser's Back button, make the button usable again
            window.addEventListener('pageshow', function (e) {
                if (e.persisted) {
                    confettiDone = false;
                    submitBtn.disabled = false;
                    submitBtn.textContent = 'Submit Report';
                    canvas.hidden = true;
                }
            });
        })();
    </script>
}
