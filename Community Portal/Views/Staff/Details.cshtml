@model CommunityPortal.Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Request Details";
}

<div class="container py-4">
    <div class="card shadow-sm max-w-800 mx-auto">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Manage Report: @Model.ReferenceNumber</h4>
            <span class="badge bg-info">@Model.StatusDisplayName</span>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <p><strong>Issue Category:</strong> @Model.IssueType</p>
                <p><strong>Location:</strong> @Model.Location</p>
                <p><strong>Description:</strong> @Model.Description</p>
            </div>

            <hr />

            <form asp-controller="Staff" asp-action="UpdateStatus" method="post">
                <!-- Hidden inputs to bind model identifier and required fields -->
                <input type="hidden" asp-for="ReferenceNumber" />
                <input type="hidden" asp-for="IssueType" />
                <input type="hidden" asp-for="Location" />
                <input type="hidden" asp-for="Description" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Status" class="form-label">Update Status</label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<CommunityPortal.Web.Models.RequestStatus>()"></select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label">Update Priority</label>
                        <select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<CommunityPortal.Web.Models.PriorityLevel>()"></select>
                    </div>
                    <div class="col-12">
                        <label asp-for="StaffNotes" class="form-label">Staff Notes / Resolution Comments</label>
                        <textarea asp-for="StaffNotes" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-12 mt-3">
                        <button type="submit" class="btn btn-success">Save Changes</button>
                        <a asp-action="Dashboard" class="btn btn-secondary">Back to Dashboard</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>