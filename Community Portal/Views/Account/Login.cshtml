@{
    ViewData["Title"] = "Municipality Login";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom border-0">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="login-badge mb-3"><i class="bi bi-shield-lock-fill"></i></div>
                    <h1 class="h4 fw-bold text-navy mb-1">Municipality Login</h1>
                    <p class="text-muted small mb-0">Authorised staff only. Sign in to manage service requests.</p>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger py-2 small" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-1"></i>@ViewBag.ErrorMessage
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post" data-loading-text="Signing in...">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />

                    <div class="mb-3">
                        <label for="email" class="form-label small">Username or email</label>
                        <input type="text" class="form-control" id="email" name="email" placeholder="Enter username or email" autocomplete="username" required autofocus />
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label small">Password</label>
                        <input type="password" class="form-control" id="password" name="password" placeholder="Enter password" autocomplete="current-password" required />
                    </div>

                    <div class="form-check mb-4">
                        <input type="checkbox" class="form-check-input" id="rememberMe" name="rememberMe" value="true" />
                        <label class="form-check-label text-secondary small" for="rememberMe">Remember me on this device</label>
                    </div>

                    <button type="submit" class="btn btn-azure w-100 btn-lg"><i class="bi bi-box-arrow-in-right me-1"></i>Log in</button>
                </form>
            </div>
        </div>
        <p class="text-center small text-muted mt-3">Not a staff member? <a asp-controller="ServiceRequest" asp-action="Create">Report a problem</a> instead.</p>
    </div>
</div>
