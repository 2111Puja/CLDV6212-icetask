@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 text-center">
        <div class="status-code">500</div>
        <h1 class="h3 fw-bold text-navy mt-2">Something went wrong on our side</h1>
        <p class="text-muted">
            An unexpected error stopped your request. Nothing you entered has been lost on your device - please try again in a moment.
        </p>
        @if (Model.ShowRequestId)
        {
            <p class="small text-muted">Support reference: <code>@Model.RequestId</code></p>
        }
        <div class="d-flex justify-content-center gap-2 mt-4">
            <a class="btn btn-azure" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Back to home</a>
            <a class="btn btn-outline-navy" href="javascript:history.back()">Go back</a>
        </div>
    </div>
</div>
