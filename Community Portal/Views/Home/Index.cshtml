@{
    ViewData["Title"] = "Home";
}

@* Home page styles. These classes are specific to this page and use the portal's navy/azure theme
   variables from wwwroot/css/site.css (with fallbacks), so no other file needs to change. *@
<style>
    .text-navy { color: var(--primary-navy, #002a5c) !important; }

    /* Hero banner */
    .hero {
        position: relative;
        overflow: hidden;
        padding: 3.5rem 2rem;
        border-radius: 16px;
        color: #ffffff;
        background: linear-gradient(135deg, #001a3a 0%, var(--primary-navy, #002a5c) 55%, var(--azure-blue, #0078d4) 130%);
    }

        .hero::after {
            content: "";
            position: absolute;
            right: -80px;
            top: -80px;
            width: 320px;
            height: 320px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.07);
        }

        .hero h1 { font-weight: 700; letter-spacing: -0.5px; }
        .hero .lead { color: #cfe0f5; max-width: 640px; }

    /* "How it works" cards */
    .feature-icon {
        width: 52px;
        height: 52px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: var(--azure-blue, #0078d4);
        background: rgba(0, 120, 212, 0.12);
    }

    .step-number {
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.85rem;
        font-weight: 700;
        color: #ffffff;
        background: var(--primary-navy, #002a5c);
    }

    .hover-lift { transition: transform 0.15s ease, box-shadow 0.15s ease; }
    .hover-lift:hover { transform: translateY(-3px); box-shadow: 0 8px 20px rgba(0, 42, 92, 0.14) !important; }

    @@media (max-width: 575.98px) {
        .hero { padding: 2.25rem 1.25rem; }
    }
</style>

<section class="hero mb-5 shadow">
    <div class="position-relative" style="z-index:2">
        <span class="badge rounded-pill text-bg-light text-navy mb-3 px-3 py-2"><i class="bi bi-patch-check-fill me-1"></i> Official municipal service channel</span>
        <h1 class="display-5">Report it. Track it. See it fixed.</h1>
        <p class="lead mt-3 mb-4">
            Spotted a water leak, a pothole or a broken streetlight? Tell your municipality in under two minutes
            and follow the repair from first report to resolution.
        </p>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-light btn-lg fw-semibold px-4" asp-controller="ServiceRequest" asp-action="Create">
                <i class="bi bi-megaphone-fill me-2"></i>Report a Problem
            </a>
            <a class="btn btn-outline-light btn-lg px-4" asp-controller="ServiceRequest" asp-action="Track">
                <i class="bi bi-search me-2"></i>Track a Report
            </a>
        </div>
    </div>
</section>

<section class="mb-5">
    <h2 class="h4 fw-bold text-navy text-center mb-4">How it works</h2>
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-lift p-4 text-center">
                <div class="mx-auto mb-3"><span class="feature-icon"><i class="bi bi-pencil-square"></i></span></div>
                <h3 class="h6 fw-bold"><span class="step-number me-2">1</span>Submit a report</h3>
                <p class="text-muted mb-0">Choose the issue type, describe the problem, add the location and an optional photo.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-lift p-4 text-center">
                <div class="mx-auto mb-3"><span class="feature-icon"><i class="bi bi-hash"></i></span></div>
                <h3 class="h6 fw-bold"><span class="step-number me-2">2</span>Get a reference number</h3>
                <p class="text-muted mb-0">Every report receives a unique reference such as <code>RPT-2026-483920</code> for tracking.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm hover-lift p-4 text-center">
                <div class="mx-auto mb-3"><span class="feature-icon"><i class="bi bi-tools"></i></span></div>
                <h3 class="h6 fw-bold"><span class="step-number me-2">3</span>Follow the repair</h3>
                <p class="text-muted mb-0">Municipal teams prioritise, assign and update your request until it is resolved.</p>
            </div>
        </div>
    </div>
</section>

<section class="mb-4">
    <h2 class="h4 fw-bold text-navy text-center mb-4">What can you report?</h2>
    <div class="row g-3 text-center">
        <div class="col-6 col-md-3"><div class="card card-custom p-3 h-100"><i class="bi bi-droplet-half fs-2 text-primary"></i><div class="fw-semibold mt-2">Water leaks</div></div></div>
        <div class="col-6 col-md-3"><div class="card card-custom p-3 h-100"><i class="bi bi-cone-striped fs-2 text-warning"></i><div class="fw-semibold mt-2">Potholes &amp; roads</div></div></div>
        <div class="col-6 col-md-3"><div class="card card-custom p-3 h-100"><i class="bi bi-lightbulb-fill fs-2 text-warning"></i><div class="fw-semibold mt-2">Streetlights</div></div></div>
        <div class="col-6 col-md-3"><div class="card card-custom p-3 h-100"><i class="bi bi-trash3-fill fs-2 text-success"></i><div class="fw-semibold mt-2">Refuse &amp; dumping</div></div></div>
    </div>
</section>
