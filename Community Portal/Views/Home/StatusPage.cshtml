@{
    int code = ViewBag.Code ?? 404;
    ViewData["Title"] = code == 404 ? "Page not found" : "Error " + code;
    var message = code switch
    {
        404 => "We couldn't find the page you were looking for. It may have moved, or the address may be mistyped.",
        403 => "You do not have permission to view this page.",
        401 => "Please log in to continue.",
        _ => "Your request could not be completed."
    };
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 text-center">
        <div class="status-code">@code</div>
        <h1 class="h3 fw-bold text-navy mt-2">@(code == 404 ? "Page not found" : "Request could not be completed")</h1>
        <p class="text-muted">@message</p>
        <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">
            <a class="btn btn-azure" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Back to home</a>
            <a class="btn btn-outline-navy" asp-controller="ServiceRequest" asp-action="Track"><i class="bi bi-search me-1"></i>Track a report</a>
        </div>
    </div>
</div>
